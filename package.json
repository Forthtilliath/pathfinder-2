{
  "name": "pf2-fr",
  "private": true,
  "type": "module",
  "scripts": {
    "import": "tsx scripts/import/index.ts",
    "import:no-translate": "tsx scripts/import/index.ts --no-translate",
    "import:offline": "tsx scripts/import/index.ts --no-translate --offline",
    "icons": "tsx scripts/icons.ts",
    "illustration": "tsx scripts/add-illustration.ts",
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run check && npm test && npm run build && npm run test:e2e"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "dependencies": {
    "@astrojs/preact": "^6.1.1",
    "@fontsource/alegreya": "^5.3.0",
    "@fontsource/alegreya-sans": "^5.3.0",
    "astro": "^7.4.7",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^16.5.0",
    "pagefind": "^1.6.0",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.5"
  }
}
