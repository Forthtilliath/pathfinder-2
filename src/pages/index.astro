---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionIcon from "../components/SectionIcon.astro";
import BookCovers from "../components/BookCovers.astro";
import { Image } from "astro:assets";
import { illustration } from "../lib/illustrations";
import { meta, pageCount } from "../lib/data";
import { navGroups } from "../lib/nav";

const groups = navGroups(pageCount);
const formatCount = (n: number) => n.toLocaleString("fr-FR");
const heroImage = illustration("home");
---

<BaseLayout title="">
  <section class="home-hero">
    <div class="home-hero-text">
      <h1>Les règles de Pathfinder 2 remasterisé, en français.</h1>
      <button type="button" class="search-field" data-open-search>
        <span>Un sort, un don, une classe…</span>
        <kbd>Ctrl K</kbd>
      </button>
    </div>
    {
      heroImage && (
        <figure class="home-illustration">
          <Image
            src={heroImage}
            alt="Un groupe d'aventuriers contemple une vallée, une tour en ruine au loin"
            widths={[480, 768, 1024, 1536]}
            sizes="(min-width: 64rem) 34rem, 100vw"
            loading="eager"
            fetchpriority="high"
          />
        </figure>
      )
    }
  </section>

  <section aria-label="Parcourir">
    {
      groups.map((g, i) => (
        <section class="home-group" aria-labelledby={`home-group-${i}`}>
          <h2 id={`home-group-${i}`}>{g.title}</h2>
          <div class="home-sections">
            {g.links.map((l) => (
              <a class="home-section" href={l.href}>
                <SectionIcon path={l.path} />
                <h3>
                  {l.title} <span class="count">{formatCount(l.count)}</span>
                </h3>
                <p>{l.intro}</p>
              </a>
            ))}
          </div>
        </section>
      ))
    }
  </section>

  <section class="home-books" aria-labelledby="home-books-title">
    <h2 id="home-books-title">Les livres de base</h2>
    <BookCovers />
    <p><a href="/sources/#livres">D'où viennent les règles</a></p>
  </section>

  <p class="updated-at">
    Données mises à jour le {new Date(meta.date).toLocaleDateString("fr-FR", { dateStyle: "long" })}.
  </p>
</BaseLayout>
