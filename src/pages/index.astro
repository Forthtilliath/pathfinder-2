---
import BaseLayout from "../layouts/BaseLayout.astro";
import { entries, entryPath, entryUrl, meta, pageCount } from "../lib/data";
import { navGroups } from "../lib/nav";

const groups = navGroups(pageCount);
const conditions = entries("conditions");
const formatCount = (n: number) => n.toLocaleString("fr-FR");
---

<BaseLayout title="">
  <section class="home-hero">
    <h1>Les règles de Pathfinder 2 remasterisé, en français.</h1>
    <button type="button" class="search-field" data-open-search>
      <span>Un sort, un don, une classe…</span>
      <kbd>Ctrl K</kbd>
    </button>
  </section>

  <section aria-label="Parcourir">
    {
      groups.map((g, i) => (
        <section class="home-group" aria-labelledby={`home-group-${i}`}>
          <h2 id={`home-group-${i}`}>{g.title}</h2>
          <div class="home-sections">
            {g.links.map((l) => (
              <a class="home-section" href={l.href}>
                <h3>
                  {l.title} <span class="count">{formatCount(l.count)}</span>
                </h3>
                <p>{l.intro}</p>
              </a>
            ))}
          </div>
        </section>
      ))
    }
  </section>

  <section class="condition-shortcuts" aria-labelledby="condition-shortcuts-title">
    <h2 id="condition-shortcuts-title">États</h2>
    <ul>
      {
        conditions.map((c) => (
          <li>
            <a href={entryUrl(c)} data-preview={entryPath(c.collection, c.id)}>
              {c.name.value}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <p class="updated-at">Données mises à jour le {new Date(meta.date).toLocaleDateString("fr-FR", { dateStyle: "long" })}.</p>
</BaseLayout>
