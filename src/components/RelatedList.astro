---
import ActionGlyph from "./ActionGlyph.astro";
import { entryPath, entryUrl } from "../lib/data";
import type { RelatedGroup } from "../lib/related";

interface Props {
  /** From relatedGroups(): the page also lists them in its table of contents. */
  groups: RelatedGroup[];
}

const { groups } = Astro.props;
---

{
  groups.map((g) => (
    <section class="related" id={g.id}>
      <h2>
        {g.title} <span class="count">{g.items.length}</span>
      </h2>
      {g.levels ? (
        <dl class="by-level">
          {g.levels.map(([level, list]) => (
            <div>
              <dt>Niveau {level}</dt>
              <dd>
                <ul>
                  {list.map((e) => (
                    <li>
                      <a href={entryUrl(e)} data-preview={entryPath(e.collection, e.id)}>
                        {e.name.value}
                      </a>
                      {e.actionCost && <ActionGlyph cost={e.actionCost} />}
                    </li>
                  ))}
                </ul>
              </dd>
            </div>
          ))}
        </dl>
      ) : (
        <ul class="related-list">
          {g.items.map((e) => (
            <li>
              <a href={entryUrl(e)} data-preview={entryPath(e.collection, e.id)}>
                {e.name.value}
              </a>
              {e.actionCost && <ActionGlyph cost={e.actionCost} />} <span class="subtitle">{e.subtitle}</span>
            </li>
          ))}
        </ul>
      )}
    </section>
  ))
}
